      ],
      "expected": {
        "url": "https://middle.example/byaiden_heygen/v3/videos",
        "method": "POST",
        "headers": {
          "Accept": "application/json",
          "Authorization": "Bearer sk-middle",
          "Content-Type": "application/json"
