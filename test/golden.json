{
  "cases": [
    {
      "name": "avatar request sends the mapped engine",
      "hook": "buildSubmitRequest",
      "args": [
        {
          "requestBody": {
            "type": "avatar",
            "avatar_id": "look_1",
            "script": "Hello from the gateway, this is a test.",
            "voice_id": "voice_1",
            "resolution": "1080p",
            "model": "heygen-avatar-iv"
          },
          "requestHeaders": {
            "Content-Type": "application/json",
            "Accept": ""
          },
          "action": "avatar_video",
          "model": "avatar",
          "upstreamModel": "heygen-avatar-v",
          "baseUrl": "https://api.heygen.com",
          "apiKey": "test-key",
          "authHeader": "Bearer test-key",
          "upstream": {
            "kind": "vendor"
          },
          "config": {},
          "files": [],
          "publicTaskId": "task_public"
        }
      ],
      "expected": {
        "url": "https://api.heygen.com/v3/videos",
        "method": "POST",
        "headers": {
          "Accept": "application/json",
          "X-Api-Key": "test-key",
          "Content-Type": "application/json"
        },
        "body": {
          "type": "avatar",
          "avatar_id": "look_1",
          "script": "Hello from the gateway, this is a test.",
          "voice_id": "voice_1",
          "resolution": "1080p",
          "engine": {
            "type": "avatar_v"
          }
        },
        "action": "avatar_video"
      }
    },
