      "args": [
        {
          "requestBody": {
            "type": "avatar",
            "avatar_id": "look_1",
            "script": "Hello from the gateway, this is a test.",
            "voice_id": "voice_1",
            "resolution": "1080p",
            "model": "heygen-avatar-iv"
          },
